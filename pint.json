{
  "preset": "laravel",
  "rules": {
    "simplified_null_return": true,
    "braces": true,
    "new_with_braces": true,
    "no_unused_imports": true,
    "ordered_imports": {
      "sort_algorithm": "alpha"
    },
    "no_extra_blank_lines": {
      "tokens": [
        "extra",
        "throw",
        "use"
      ]
    },
    "not_operator_with_successor_space": true,
    "trailing_comma_in_multiline": {
      "elements": [
        "arrays"
      ]
    }
  }
}
